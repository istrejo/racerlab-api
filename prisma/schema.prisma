generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ADVISOR
  TECHNICIAN
  INVENTORY_MANAGER

  @@map("user_role")
}

enum ServiceOrderStatus {
  RECEIVED
  DIAGNOSIS
  QUOTED
  APPROVED
  IN_PROGRESS
  QUALITY_CONTROL
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED

  @@map("service_order_status")
}

enum ServiceOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("service_order_priority")
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTERS
  FULL

  @@map("fuel_level")
}

enum QuoteStatus {
  DRAFT
  ACTIVE
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("quote_status")
}

enum QuoteItemType {
  PART
  LABOR
  SERVICE
  OTHER

  @@map("quote_item_type")
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN

  @@map("inventory_movement_type")
}

enum RepairTaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED

  @@map("repair_task_status")
}

enum ProductUnit {
  UNIT
  LITER
  MILLILITER
  KILOGRAM
  GRAM
  METER
  CENTIMETER
  HOUR
  PACKAGE

  @@map("product_unit")
}

enum EvidenceStage {
  RECEPTION
  DIAGNOSIS
  REPAIR
  QUALITY_CONTROL
  DELIVERY
  OTHER

  @@map("evidence_stage")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        UserRole         @unique
  description String?
  users       User[]
  memberships Membership[]
  invitations Invitation[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model User {
  id                         String                      @id @default(uuid()) @db.Uuid
  roleId                     String                      @map("role_id") @db.Uuid
  role                       Role                        @relation(fields: [roleId], references: [id])
  name                       String
  email                      String                      @unique
  passwordHash               String                      @map("password_hash")
  isActive                   Boolean                     @default(true) @map("is_active")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  ownedWorkshop              Workshop?                   @relation("WorkshopOwner")
  memberships                Membership[]
  issuedInvitations          Invitation[]                @relation("InvitationIssuedBy")
  acceptedInvitations        Invitation[]                @relation("InvitationAcceptedBy")
  authSelections             AuthSelection[]
  createdServiceOrders       ServiceOrder[]              @relation("ServiceOrderCreatedBy")
  assignedServiceOrders      ServiceOrder[]              @relation("ServiceOrderAssignedTechnician")
  technicianAssignments      ServiceOrderTechnician[]    @relation("ServiceOrderTechnicianTechnician")
  assignedTechnicians        ServiceOrderTechnician[]    @relation("ServiceOrderTechnicianAssignedBy")
  statusChanges              ServiceOrderStatusHistory[]
  diagnoses                  Diagnosis[]
  quotes                     Quote[]
  inventoryMovements         InventoryMovement[]
  repairTasks                RepairTask[]
  authSessions               AuthSession[]
  evidences                  Evidence[]
  comments                   Comment[]

  @@index([roleId], map: "users_role_id_idx")
  @@map("users")
}

model Workshop {
  id                       String                      @id @default(uuid()) @db.Uuid
  name                     String
  ownerUserId              String                      @unique(map: "workshops_owner_user_id_key") @map("owner_user_id") @db.Uuid
  ownerUser                User                        @relation("WorkshopOwner", fields: [ownerUserId], references: [id])
  memberships              Membership[]
  invitations              Invitation[]
  customers                Customer[]
  vehicles                 Vehicle[]
  serviceOrders            ServiceOrder[]
  serviceOrderTechnicians  ServiceOrderTechnician[]
  serviceOrderStatusEvents ServiceOrderStatusHistory[]
  diagnoses                Diagnosis[]
  quotes                   Quote[]
  quoteItems               QuoteItem[]
  inventoryCategories      InventoryCategory[]
  inventoryProducts        InventoryProduct[]
  inventoryMovements       InventoryMovement[]
  repairTasks              RepairTask[]
  evidences                Evidence[]
  comments                 Comment[]
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")

  @@map("workshops")
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshopId  String        @map("workshop_id") @db.Uuid
  workshop    Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  roleId      String        @map("role_id") @db.Uuid
  role        Role          @relation(fields: [roleId], references: [id])
  isActive    Boolean       @default(true) @map("is_active")
  revokedAt   DateTime?     @map("revoked_at")
  authSessions AuthSession[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([userId, workshopId], map: "membership_user_workshop_unique")
  @@unique([id, userId], map: "membership_id_user_unique")
  @@index([userId], map: "memberships_user_id_idx")
  @@index([workshopId], map: "memberships_workshop_id_idx")
  @@index([roleId], map: "memberships_role_id_idx")
  @@map("memberships")
}

model Invitation {
  id               String    @id @default(uuid()) @db.Uuid
  workshopId       String    @map("workshop_id") @db.Uuid
  workshop         Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  email            String
  roleId           String    @map("role_id") @db.Uuid
  role             Role      @relation(fields: [roleId], references: [id])
  tokenHash        String    @unique(map: "invitations_token_hash_key") @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  issuedByUserId   String    @map("issued_by_user_id") @db.Uuid
  issuedByUser     User      @relation("InvitationIssuedBy", fields: [issuedByUserId], references: [id])
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  acceptedByUser   User?     @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id])
  acceptedAt       DateTime? @map("accepted_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([workshopId, email], map: "invitation_workshop_email_unique")
  @@index([roleId], map: "invitations_role_id_idx")
  @@index([issuedByUserId], map: "invitations_issued_by_user_id_idx")
  @@index([acceptedByUserId], map: "invitations_accepted_by_user_id_idx")
  @@index([expiresAt], map: "invitations_expires_at_idx")
  @@map("invitations")
}

model AuthSelection {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique(map: "auth_selections_token_hash_key") @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId], map: "auth_selections_user_id_idx")
  @@index([expiresAt], map: "auth_selections_expires_at_idx")
  @@map("auth_selections")
}

model AuthSession {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  membershipId        String?     @map("membership_id") @db.Uuid
  tokenFamilyId       String      @map("token_family_id") @db.Uuid
  tokenHash           String      @unique(map: "auth_sessions_token_hash_key") @map("token_hash")
  expiresAt           DateTime    @map("expires_at")
  consumedAt          DateTime?   @map("consumed_at")
  revokedAt           DateTime?   @map("revoked_at")
  replacedBySessionId String?     @map("replaced_by_session_id") @db.Uuid
  createdUserAgent    String?     @map("created_user_agent")
  createdIp           String?     @map("created_ip")
  lastUsedUserAgent   String?     @map("last_used_user_agent")
  lastUsedIp          String?     @map("last_used_ip")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership          Membership? @relation(fields: [membershipId, userId], references: [id, userId], map: "auth_session_membership_user_fk")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([membershipId], map: "auth_sessions_membership_id_idx")
  @@index([tokenFamilyId], map: "auth_sessions_token_family_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  workshopId    String         @map("workshop_id") @db.Uuid
  workshop      Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  fullName      String         @map("full_name")
  phone         String?
  whatsapp      String?
  email         String?
  document      String?
  address       String?
  notes         String?
  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([id, workshopId], map: "customer_id_workshop_unique")
  @@index([workshopId], map: "customers_workshop_id_idx")
  @@map("customers")
}

model Vehicle {
  id            String         @id @default(uuid()) @db.Uuid
  workshopId    String         @map("workshop_id") @db.Uuid
  workshop      Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customerId    String         @map("customer_id") @db.Uuid
  customer      Customer       @relation(fields: [customerId, workshopId], references: [id, workshopId])
  plate         String
  brand         String
  model         String
  year          Int?
  color         String?
  vin           String?
  mileage       Int?
  vehicleType   String?        @map("vehicle_type")
  notes         String?
  serviceOrders ServiceOrder[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([id, workshopId], map: "vehicle_id_workshop_unique")
  @@unique([workshopId, plate], map: "vehicles_workshop_id_plate_key")
  @@index([customerId], map: "vehicles_customer_id_idx")
  @@index([workshopId], map: "vehicles_workshop_id_idx")
  @@map("vehicles")
}

model ServiceOrder {
  id                    String                      @id @default(uuid()) @db.Uuid
  workshopId            String                      @map("workshop_id") @db.Uuid
  workshop              Workshop                    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  code                  String
  customerId            String                      @map("customer_id") @db.Uuid
  customer              Customer                    @relation(fields: [customerId, workshopId], references: [id, workshopId])
  vehicleId             String                      @map("vehicle_id") @db.Uuid
  vehicle               Vehicle                     @relation(fields: [vehicleId, workshopId], references: [id, workshopId])
  assignedTechnicianId  String?                     @map("assigned_technician_id") @db.Uuid
  assignedTechnician    User?                       @relation("ServiceOrderAssignedTechnician", fields: [assignedTechnicianId], references: [id])
  createdById           String                      @map("created_by_id") @db.Uuid
  createdBy             User                        @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id])
  status                ServiceOrderStatus          @default(RECEIVED)
  priority              ServiceOrderPriority?       @default(NORMAL)
  reportedIssues        String?                     @map("reported_issues")
  receptionNotes        String?                     @map("reception_notes")
  mileageIn             Int?                        @map("mileage_in")
  fuelLevel             FuelLevel?                  @map("fuel_level")
  estimatedDeliveryDate DateTime?                   @map("estimated_delivery_date") @db.Date
  totalEstimated        Decimal?                    @map("total_estimated") @db.Decimal(12, 2)
  totalApproved         Decimal?                    @map("total_approved") @db.Decimal(12, 2)
  totalFinal            Decimal?                    @map("total_final") @db.Decimal(12, 2)
  closedAt              DateTime?                   @map("closed_at")
  technicians           ServiceOrderTechnician[]
  statusHistory         ServiceOrderStatusHistory[]
  diagnoses             Diagnosis[]
  quotes                Quote[]
  inventoryMovements    InventoryMovement[]
  repairTasks           RepairTask[]
  evidences             Evidence[]
  comments              Comment[]
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  @@unique([id, workshopId], map: "service_order_id_workshop_unique")
  @@unique([workshopId, code], map: "service_orders_workshop_id_code_key")
  @@index([customerId], map: "service_orders_customer_id_idx")
  @@index([vehicleId], map: "service_orders_vehicle_id_idx")
  @@index([assignedTechnicianId], map: "service_orders_assigned_technician_id_idx")
  @@index([createdById], map: "service_orders_created_by_id_idx")
  @@index([workshopId], map: "service_orders_workshop_id_idx")
  @@map("service_orders")
}

model ServiceOrderTechnician {
  serviceOrderId String       @map("service_order_id") @db.Uuid
  workshopId     String       @map("workshop_id") @db.Uuid
  workshop       Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId, workshopId], references: [id, workshopId], onDelete: Cascade)
  technicianId   String       @map("technician_id") @db.Uuid
  technician     User         @relation("ServiceOrderTechnicianTechnician", fields: [technicianId], references: [id])
  assignedById   String?      @map("assigned_by_id") @db.Uuid
  assignedBy     User?        @relation("ServiceOrderTechnicianAssignedBy", fields: [assignedById], references: [id])
  assignedAt     DateTime     @default(now()) @map("assigned_at")

  @@id([serviceOrderId, technicianId])
  @@index([technicianId], map: "service_order_technicians_technician_id_idx")
  @@index([assignedById], map: "service_order_technicians_assigned_by_id_idx")
  @@index([workshopId], map: "service_order_technicians_workshop_id_idx")
  @@map("service_order_technicians")
}

model ServiceOrderStatusHistory {
  id             String              @id @default(uuid()) @db.Uuid
  workshopId     String              @map("workshop_id") @db.Uuid
  workshop       Workshop            @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  serviceOrderId String              @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder        @relation(fields: [serviceOrderId, workshopId], references: [id, workshopId], onDelete: Cascade)
  previousStatus ServiceOrderStatus? @map("previous_status")
  newStatus      ServiceOrderStatus  @map("new_status")
  changedById    String              @map("changed_by_id") @db.Uuid
  changedBy      User                @relation(fields: [changedById], references: [id])
  comment        String?
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([serviceOrderId], map: "service_order_status_history_service_order_id_idx")
  @@index([changedById], map: "service_order_status_history_changed_by_id_idx")
  @@index([workshopId], map: "service_order_status_history_workshop_id_idx")
  @@map("service_order_status_history")
}

model Diagnosis {
  id                 String       @id @default(uuid()) @db.Uuid
  workshopId         String       @map("workshop_id") @db.Uuid
  workshop           Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  serviceOrderId     String       @map("service_order_id") @db.Uuid
  serviceOrder       ServiceOrder @relation(fields: [serviceOrderId, workshopId], references: [id, workshopId], onDelete: Cascade)
  technicianId       String       @map("technician_id") @db.Uuid
  technician         User         @relation(fields: [technicianId], references: [id])
  description        String
  requiredPartsNotes String?      @map("required_parts_notes")
  suggestedLabor     String?      @map("suggested_labor")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([serviceOrderId], map: "diagnoses_service_order_id_idx")
  @@index([technicianId], map: "diagnoses_technician_id_idx")
  @@index([workshopId], map: "diagnoses_workshop_id_idx")
  @@map("diagnoses")
}

model Quote {
  id             String       @id @default(uuid()) @db.Uuid
  workshopId     String       @map("workshop_id") @db.Uuid
  workshop       Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId, workshopId], references: [id, workshopId], onDelete: Cascade)
  createdById    String       @map("created_by_id") @db.Uuid
  createdBy      User         @relation(fields: [createdById], references: [id])
  status         QuoteStatus  @default(DRAFT)
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discount       Decimal?     @db.Decimal(12, 2)
  tax            Decimal?     @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  approvalMethod String?      @map("approval_method")
  approvedAt     DateTime?    @map("approved_at")
  rejectedAt     DateTime?    @map("rejected_at")
  items          QuoteItem[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([id, workshopId], map: "quotes_id_workshop_unique")
  @@index([serviceOrderId], map: "quotes_service_order_id_idx")
  @@index([createdById], map: "quotes_created_by_id_idx")
  @@index([workshopId], map: "quotes_workshop_id_idx")
  @@map("quotes")
}

model QuoteItem {
  id                 String            @id @default(uuid()) @db.Uuid
  workshopId         String            @map("workshop_id") @db.Uuid
  workshop           Workshop          @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  quoteId            String            @map("quote_id") @db.Uuid
  quote              Quote             @relation(fields: [quoteId, workshopId], references: [id, workshopId], onDelete: Cascade)
  inventoryProductId String?           @map("inventory_product_id") @db.Uuid
  inventoryProduct   InventoryProduct? @relation(fields: [inventoryProductId, workshopId], references: [id, workshopId])
  type               QuoteItemType
  description        String
  quantity           Decimal           @db.Decimal(12, 3)
  unitPrice          Decimal           @map("unit_price") @db.Decimal(12, 2)
  costPrice          Decimal?          @map("cost_price") @db.Decimal(12, 2)
  total              Decimal           @db.Decimal(12, 2)
  isApproved         Boolean?          @map("is_approved")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([quoteId], map: "quote_items_quote_id_idx")
  @@index([inventoryProductId], map: "quote_items_inventory_product_id_idx")
  @@index([workshopId], map: "quote_items_workshop_id_idx")
  @@map("quote_items")
}

model InventoryCategory {
  id          String             @id @default(uuid()) @db.Uuid
  workshopId  String             @map("workshop_id") @db.Uuid
  workshop    Workshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean            @default(true) @map("is_active")
  products    InventoryProduct[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([id, workshopId], map: "inventory_category_id_workshop_unique")
  @@unique([workshopId, name], map: "inventory_categories_workshop_id_name_key")
  @@index([workshopId], map: "inventory_categories_workshop_id_idx")
  @@map("inventory_categories")
}

model InventoryProduct {
  id                 String              @id @default(uuid()) @db.Uuid
  workshopId         String              @map("workshop_id") @db.Uuid
  workshop           Workshop            @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  categoryId         String?             @map("category_id") @db.Uuid
  category           InventoryCategory?  @relation(fields: [categoryId, workshopId], references: [id, workshopId])
  name               String
  sku                String?
  brand              String?
  description        String?
  unit               ProductUnit
  costPrice          Decimal?            @map("cost_price") @db.Decimal(12, 2)
  salePrice          Decimal?            @map("sale_price") @db.Decimal(12, 2)
  currentStock       Decimal             @default(0) @map("current_stock") @db.Decimal(12, 3)
  minimumStock       Decimal?            @map("minimum_stock") @db.Decimal(12, 3)
  location           String?
  isActive           Boolean             @default(true) @map("is_active")
  quoteItems         QuoteItem[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([id, workshopId], map: "inventory_product_id_workshop_unique")
  @@unique([workshopId, sku], map: "inventory_products_workshop_id_sku_key")
  @@index([categoryId], map: "inventory_products_category_id_idx")
  @@index([workshopId], map: "inventory_products_workshop_id_idx")
  @@map("inventory_products")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  workshopId     String                @map("workshop_id") @db.Uuid
  workshop       Workshop              @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  productId      String                @map("product_id") @db.Uuid
  product        InventoryProduct      @relation(fields: [productId, workshopId], references: [id, workshopId])
  serviceOrderId String?               @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder?         @relation(fields: [serviceOrderId, workshopId], references: [id, workshopId])
  createdById    String                @map("created_by_id") @db.Uuid
  createdBy      User                  @relation(fields: [createdById], references: [id])
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(12, 3)
  previousStock  Decimal?              @map("previous_stock") @db.Decimal(12, 3)
  newStock       Decimal?              @map("new_stock") @db.Decimal(12, 3)
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([productId], map: "inventory_movements_product_id_idx")
  @@index([serviceOrderId], map: "inventory_movements_service_order_id_idx")
  @@index([createdById], map: "inventory_movements_created_by_id_idx")
  @@index([workshopId], map: "inventory_movements_workshop_id_idx")
  @@map("inventory_movements")
}

model RepairTask {
  id                   String           @id @default(uuid()) @db.Uuid
  workshopId           String           @map("workshop_id") @db.Uuid
  workshop             Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  serviceOrderId       String           @map("service_order_id") @db.Uuid
  serviceOrder         ServiceOrder     @relation(fields: [serviceOrderId, workshopId], references: [id, workshopId], onDelete: Cascade)
  assignedTechnicianId String?          @map("assigned_technician_id") @db.Uuid
  assignedTechnician   User?            @relation(fields: [assignedTechnicianId], references: [id])
  title                String
  description          String?
  status               RepairTaskStatus @default(PENDING)
  startedAt            DateTime?        @map("started_at")
  completedAt          DateTime?        @map("completed_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([serviceOrderId], map: "repair_tasks_service_order_id_idx")
  @@index([assignedTechnicianId], map: "repair_tasks_assigned_technician_id_idx")
  @@index([workshopId], map: "repair_tasks_workshop_id_idx")
  @@map("repair_tasks")
}

model Evidence {
  id             String        @id @default(uuid()) @db.Uuid
  workshopId     String        @map("workshop_id") @db.Uuid
  workshop       Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  serviceOrderId String        @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder  @relation(fields: [serviceOrderId, workshopId], references: [id, workshopId], onDelete: Cascade)
  uploadedById   String        @map("uploaded_by_id") @db.Uuid
  uploadedBy     User          @relation(fields: [uploadedById], references: [id])
  stage          EvidenceStage
  fileUrl        String        @map("file_url")
  storagePath    String?       @map("storage_path")
  fileType       String?       @map("file_type")
  description    String?
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([serviceOrderId], map: "evidences_service_order_id_idx")
  @@index([uploadedById], map: "evidences_uploaded_by_id_idx")
  @@index([workshopId], map: "evidences_workshop_id_idx")
  @@map("evidences")
}

model Comment {
  id             String       @id @default(uuid()) @db.Uuid
  workshopId     String       @map("workshop_id") @db.Uuid
  workshop       Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId, workshopId], references: [id, workshopId], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id])
  content        String
  isInternal     Boolean      @default(true) @map("is_internal")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([serviceOrderId], map: "comments_service_order_id_idx")
  @@index([userId], map: "comments_user_id_idx")
  @@index([workshopId], map: "comments_workshop_id_idx")
  @@map("comments")
}

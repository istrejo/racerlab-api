generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ADVISOR
  TECHNICIAN
  INVENTORY_MANAGER

  @@map("user_role")
}

enum ServiceOrderStatus {
  RECEIVED
  DIAGNOSIS
  QUOTED
  APPROVED
  IN_PROGRESS
  QUALITY_CONTROL
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED

  @@map("service_order_status")
}

enum ServiceOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("service_order_priority")
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTERS
  FULL

  @@map("fuel_level")
}

enum QuoteStatus {
  DRAFT
  ACTIVE
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("quote_status")
}

enum QuoteItemType {
  PART
  LABOR
  SERVICE
  OTHER

  @@map("quote_item_type")
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN

  @@map("inventory_movement_type")
}

enum RepairTaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED

  @@map("repair_task_status")
}

enum ProductUnit {
  UNIT
  LITER
  MILLILITER
  KILOGRAM
  GRAM
  METER
  CENTIMETER
  HOUR
  PACKAGE

  @@map("product_unit")
}

enum EvidenceStage {
  RECEPTION
  DIAGNOSIS
  REPAIR
  QUALITY_CONTROL
  DELIVERY
  OTHER

  @@map("evidence_stage")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        UserRole         @unique
  description String?
  memberships Membership[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  email              String        @unique
  passwordHash       String        @map("password_hash")
  isActive           Boolean       @default(true) @map("is_active")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  memberships        Membership[]
  ownedWorkshops     Workshop[]    @relation("WorkshopOwner")
  authSessions       AuthSession[]
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Workshop {
  id                  String                      @id @default(uuid()) @db.Uuid
  name                String
  ownerUserId         String                      @map("owner_user_id") @db.Uuid
  ownerUser           User                        @relation("WorkshopOwner", fields: [ownerUserId], references: [id])
  memberships         Membership[]
  customers           Customer[]
  vehicles            Vehicle[]
  serviceOrders       ServiceOrder[]
  technicians         ServiceOrderTechnician[]
  statusHistory       ServiceOrderStatusHistory[]
  diagnoses           Diagnosis[]
  quotes              Quote[]
  quoteItems          QuoteItem[]
  inventoryCategories InventoryCategory[]
  inventoryProducts   InventoryProduct[]
  inventoryMovements  InventoryMovement[]
  repairTasks         RepairTask[]
  evidences           Evidence[]
  comments            Comment[]
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@index([ownerUserId], map: "workshops_owner_user_id_idx")
  @@map("workshops")
}

model Membership {
  id                    String                      @id @default(uuid()) @db.Uuid
  workshopId            String                      @map("workshop_id") @db.Uuid
  workshop              Workshop                    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  userId                String                      @map("user_id") @db.Uuid
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId                String                      @map("role_id") @db.Uuid
  role                  Role                        @relation(fields: [roleId], references: [id])
  displayName           String                      @map("display_name")
  phone                 String?
  address               String?
  isActive              Boolean                     @default(true) @map("is_active")
  deactivatedAt         DateTime?                   @map("deactivated_at")
  authSessions          AuthSession[]
  createdServiceOrders  ServiceOrder[]              @relation("ServiceOrderCreatedBy")
  assignedServiceOrders ServiceOrder[]              @relation("ServiceOrderAssignedTechnician")
  technicianAssignments ServiceOrderTechnician[]    @relation("ServiceOrderTechnicianTechnician")
  assignedTechnicians   ServiceOrderTechnician[]    @relation("ServiceOrderTechnicianAssignedBy")
  statusChanges         ServiceOrderStatusHistory[]
  diagnoses             Diagnosis[]
  quotes                Quote[]
  inventoryMovements    InventoryMovement[]
  repairTasks           RepairTask[]
  evidences             Evidence[]
  comments              Comment[]
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  @@unique([workshopId, userId], map: "memberships_workshop_id_user_id_key")
  @@unique([workshopId, id], map: "memberships_workshop_id_id_key")
  @@unique([id, userId], map: "memberships_id_user_id_key")
  @@index([roleId], map: "memberships_role_id_idx")
  @@index([workshopId, isActive], map: "memberships_workshop_id_is_active_idx")
  @@map("memberships")
}

model AuthSession {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  activeMembershipId  String?     @map("active_membership_id") @db.Uuid
  tokenFamilyId       String      @map("token_family_id") @db.Uuid
  tokenHash           String      @unique(map: "auth_sessions_token_hash_key") @map("token_hash")
  expiresAt           DateTime    @map("expires_at")
  consumedAt          DateTime?   @map("consumed_at")
  revokedAt           DateTime?   @map("revoked_at")
  replacedBySessionId String?     @map("replaced_by_session_id") @db.Uuid
  createdUserAgent    String?     @map("created_user_agent")
  createdIp           String?     @map("created_ip")
  lastUsedUserAgent   String?     @map("last_used_user_agent")
  lastUsedIp          String?     @map("last_used_ip")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership    Membership? @relation(fields: [activeMembershipId, userId], references: [id, userId])

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([activeMembershipId], map: "auth_sessions_active_membership_id_idx")
  @@index([tokenFamilyId], map: "auth_sessions_token_family_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  workshopId    String         @map("workshop_id") @db.Uuid
  workshop      Workshop       @relation(fields: [workshopId], references: [id])
  fullName      String         @map("full_name")
  phone         String?
  whatsapp      String?
  email         String?
  document      String?
  address       String?
  notes         String?
  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([workshopId, id], map: "customers_workshop_id_id_key")
  @@unique([workshopId, document], map: "customers_workshop_id_document_key")
  @@index([workshopId, fullName], map: "customers_workshop_id_full_name_idx")
  @@map("customers")
}

model Vehicle {
  id            String         @id @default(uuid()) @db.Uuid
  workshopId    String         @map("workshop_id") @db.Uuid
  workshop      Workshop       @relation(fields: [workshopId], references: [id])
  customerId    String         @map("customer_id") @db.Uuid
  customer      Customer       @relation(fields: [workshopId, customerId], references: [workshopId, id])
  plate         String
  brand         String
  model         String
  year          Int?
  color         String?
  vin           String?
  mileage       Int?
  vehicleType   String?        @map("vehicle_type")
  notes         String?
  serviceOrders ServiceOrder[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([workshopId, id], map: "vehicles_workshop_id_id_key")
  @@unique([workshopId, plate], map: "vehicles_workshop_id_plate_key")
  @@index([workshopId, customerId], map: "vehicles_workshop_id_customer_id_idx")
  @@map("vehicles")
}

model ServiceOrder {
  id                    String                      @id @default(uuid()) @db.Uuid
  workshopId            String                      @map("workshop_id") @db.Uuid
  workshop              Workshop                    @relation(fields: [workshopId], references: [id])
  code                  String
  customerId            String                      @map("customer_id") @db.Uuid
  customer              Customer                    @relation(fields: [workshopId, customerId], references: [workshopId, id])
  vehicleId             String                      @map("vehicle_id") @db.Uuid
  vehicle               Vehicle                     @relation(fields: [workshopId, vehicleId], references: [workshopId, id])
  assignedTechnicianId  String?                     @map("assigned_technician_id") @db.Uuid
  assignedTechnician    Membership?                 @relation("ServiceOrderAssignedTechnician", fields: [workshopId, assignedTechnicianId], references: [workshopId, userId])
  createdById           String                      @map("created_by_id") @db.Uuid
  createdBy             Membership                  @relation("ServiceOrderCreatedBy", fields: [workshopId, createdById], references: [workshopId, userId])
  status                ServiceOrderStatus          @default(RECEIVED)
  priority              ServiceOrderPriority?       @default(NORMAL)
  reportedIssues        String?                     @map("reported_issues")
  receptionNotes        String?                     @map("reception_notes")
  mileageIn             Int?                        @map("mileage_in")
  fuelLevel             FuelLevel?                  @map("fuel_level")
  estimatedDeliveryDate DateTime?                   @map("estimated_delivery_date") @db.Date
  totalEstimated        Decimal?                    @map("total_estimated") @db.Decimal(12, 2)
  totalApproved         Decimal?                    @map("total_approved") @db.Decimal(12, 2)
  totalFinal            Decimal?                    @map("total_final") @db.Decimal(12, 2)
  closedAt              DateTime?                   @map("closed_at")
  technicians           ServiceOrderTechnician[]
  statusHistory         ServiceOrderStatusHistory[]
  diagnoses             Diagnosis[]
  quotes                Quote[]
  inventoryMovements    InventoryMovement[]
  repairTasks           RepairTask[]
  evidences             Evidence[]
  comments              Comment[]
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  @@unique([workshopId, id], map: "service_orders_workshop_id_id_key")
  @@unique([workshopId, code], map: "service_orders_workshop_id_code_key")
  @@index([workshopId, customerId], map: "service_orders_workshop_id_customer_id_idx")
  @@index([workshopId, vehicleId], map: "service_orders_workshop_id_vehicle_id_idx")
  @@index([workshopId, assignedTechnicianId], map: "service_orders_workshop_id_assigned_technician_id_idx")
  @@index([workshopId, createdById], map: "service_orders_workshop_id_created_by_id_idx")
  @@index([workshopId, status, createdAt], map: "service_orders_workshop_id_status_created_at_idx")
  @@map("service_orders")
}

model ServiceOrderTechnician {
  workshopId     String       @map("workshop_id") @db.Uuid
  workshop       Workshop     @relation(fields: [workshopId], references: [id])
  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [workshopId, serviceOrderId], references: [workshopId, id], onDelete: Cascade)
  technicianId   String       @map("technician_id") @db.Uuid
  technician     Membership   @relation("ServiceOrderTechnicianTechnician", fields: [workshopId, technicianId], references: [workshopId, userId])
  assignedById   String?      @map("assigned_by_id") @db.Uuid
  assignedBy     Membership?  @relation("ServiceOrderTechnicianAssignedBy", fields: [workshopId, assignedById], references: [workshopId, userId])
  assignedAt     DateTime     @default(now()) @map("assigned_at")

  @@id([workshopId, serviceOrderId, technicianId])
  @@index([workshopId, technicianId], map: "service_order_technicians_workshop_id_technician_id_idx")
  @@index([workshopId, assignedById], map: "service_order_technicians_workshop_id_assigned_by_id_idx")
  @@map("service_order_technicians")
}

model ServiceOrderStatusHistory {
  id             String              @id @default(uuid()) @db.Uuid
  workshopId     String              @map("workshop_id") @db.Uuid
  workshop       Workshop            @relation(fields: [workshopId], references: [id])
  serviceOrderId String              @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder        @relation(fields: [workshopId, serviceOrderId], references: [workshopId, id], onDelete: Cascade)
  previousStatus ServiceOrderStatus? @map("previous_status")
  newStatus      ServiceOrderStatus  @map("new_status")
  changedById    String              @map("changed_by_id") @db.Uuid
  changedBy      Membership          @relation(fields: [workshopId, changedById], references: [workshopId, userId])
  comment        String?
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([workshopId, serviceOrderId], map: "service_order_status_history_workshop_id_service_order_id_idx")
  @@index([workshopId, changedById], map: "service_order_status_history_workshop_id_changed_by_id_idx")
  @@map("service_order_status_history")
}

model Diagnosis {
  id                 String       @id @default(uuid()) @db.Uuid
  workshopId         String       @map("workshop_id") @db.Uuid
  workshop           Workshop     @relation(fields: [workshopId], references: [id])
  serviceOrderId     String       @map("service_order_id") @db.Uuid
  serviceOrder       ServiceOrder @relation(fields: [workshopId, serviceOrderId], references: [workshopId, id], onDelete: Cascade)
  technicianId       String       @map("technician_id") @db.Uuid
  technician         Membership   @relation(fields: [workshopId, technicianId], references: [workshopId, userId])
  description        String
  requiredPartsNotes String?      @map("required_parts_notes")
  suggestedLabor     String?      @map("suggested_labor")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([workshopId, serviceOrderId], map: "diagnoses_workshop_id_service_order_id_idx")
  @@index([workshopId, technicianId], map: "diagnoses_workshop_id_technician_id_idx")
  @@map("diagnoses")
}

model Quote {
  id             String       @id @default(uuid()) @db.Uuid
  workshopId     String       @map("workshop_id") @db.Uuid
  workshop       Workshop     @relation(fields: [workshopId], references: [id])
  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [workshopId, serviceOrderId], references: [workshopId, id], onDelete: Cascade)
  createdById    String       @map("created_by_id") @db.Uuid
  createdBy      Membership   @relation(fields: [workshopId, createdById], references: [workshopId, userId])
  status         QuoteStatus  @default(DRAFT)
  subtotal       Decimal      @default(0) @db.Decimal(12, 2)
  discount       Decimal?     @db.Decimal(12, 2)
  tax            Decimal?     @db.Decimal(12, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  approvalMethod String?      @map("approval_method")
  approvedAt     DateTime?    @map("approved_at")
  rejectedAt     DateTime?    @map("rejected_at")
  items          QuoteItem[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([workshopId, id], map: "quotes_workshop_id_id_key")
  @@index([workshopId, serviceOrderId], map: "quotes_workshop_id_service_order_id_idx")
  @@index([workshopId, createdById], map: "quotes_workshop_id_created_by_id_idx")
  @@map("quotes")
}

model QuoteItem {
  id                 String            @id @default(uuid()) @db.Uuid
  workshopId         String            @map("workshop_id") @db.Uuid
  workshop           Workshop          @relation(fields: [workshopId], references: [id])
  quoteId            String            @map("quote_id") @db.Uuid
  quote              Quote             @relation(fields: [workshopId, quoteId], references: [workshopId, id], onDelete: Cascade)
  inventoryProductId String?           @map("inventory_product_id") @db.Uuid
  inventoryProduct   InventoryProduct? @relation(fields: [workshopId, inventoryProductId], references: [workshopId, id])
  type               QuoteItemType
  description        String
  quantity           Decimal           @db.Decimal(12, 3)
  unitPrice          Decimal           @map("unit_price") @db.Decimal(12, 2)
  costPrice          Decimal?          @map("cost_price") @db.Decimal(12, 2)
  total              Decimal           @db.Decimal(12, 2)
  isApproved         Boolean?          @map("is_approved")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([workshopId, quoteId], map: "quote_items_workshop_id_quote_id_idx")
  @@index([workshopId, inventoryProductId], map: "quote_items_workshop_id_inventory_product_id_idx")
  @@map("quote_items")
}

model InventoryCategory {
  id          String             @id @default(uuid()) @db.Uuid
  workshopId  String             @map("workshop_id") @db.Uuid
  workshop    Workshop           @relation(fields: [workshopId], references: [id])
  name        String
  description String?
  isActive    Boolean            @default(true) @map("is_active")
  products    InventoryProduct[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([workshopId, id], map: "inventory_categories_workshop_id_id_key")
  @@unique([workshopId, name], map: "inventory_categories_workshop_id_name_key")
  @@map("inventory_categories")
}

model InventoryProduct {
  id                 String              @id @default(uuid()) @db.Uuid
  workshopId         String              @map("workshop_id") @db.Uuid
  workshop           Workshop            @relation(fields: [workshopId], references: [id])
  categoryId         String?             @map("category_id") @db.Uuid
  category           InventoryCategory?  @relation(fields: [workshopId, categoryId], references: [workshopId, id])
  name               String
  sku                String?
  brand              String?
  description        String?
  unit               ProductUnit
  costPrice          Decimal?            @map("cost_price") @db.Decimal(12, 2)
  salePrice          Decimal?            @map("sale_price") @db.Decimal(12, 2)
  currentStock       Decimal             @default(0) @map("current_stock") @db.Decimal(12, 3)
  minimumStock       Decimal?            @map("minimum_stock") @db.Decimal(12, 3)
  location           String?
  isActive           Boolean             @default(true) @map("is_active")
  quoteItems         QuoteItem[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([workshopId, id], map: "inventory_products_workshop_id_id_key")
  @@unique([workshopId, sku], map: "inventory_products_workshop_id_sku_key")
  @@index([workshopId, categoryId], map: "inventory_products_workshop_id_category_id_idx")
  @@map("inventory_products")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  workshopId     String                @map("workshop_id") @db.Uuid
  workshop       Workshop              @relation(fields: [workshopId], references: [id])
  productId      String                @map("product_id") @db.Uuid
  product        InventoryProduct      @relation(fields: [workshopId, productId], references: [workshopId, id])
  serviceOrderId String?               @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder?         @relation(fields: [workshopId, serviceOrderId], references: [workshopId, id])
  createdById    String                @map("created_by_id") @db.Uuid
  createdBy      Membership            @relation(fields: [workshopId, createdById], references: [workshopId, userId])
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(12, 3)
  previousStock  Decimal?              @map("previous_stock") @db.Decimal(12, 3)
  newStock       Decimal?              @map("new_stock") @db.Decimal(12, 3)
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([workshopId, productId], map: "inventory_movements_workshop_id_product_id_idx")
  @@index([workshopId, serviceOrderId], map: "inventory_movements_workshop_id_service_order_id_idx")
  @@index([workshopId, createdById], map: "inventory_movements_workshop_id_created_by_id_idx")
  @@map("inventory_movements")
}

model RepairTask {
  id                   String           @id @default(uuid()) @db.Uuid
  workshopId           String           @map("workshop_id") @db.Uuid
  workshop             Workshop         @relation(fields: [workshopId], references: [id])
  serviceOrderId       String           @map("service_order_id") @db.Uuid
  serviceOrder         ServiceOrder     @relation(fields: [workshopId, serviceOrderId], references: [workshopId, id], onDelete: Cascade)
  assignedTechnicianId String?          @map("assigned_technician_id") @db.Uuid
  assignedTechnician   Membership?      @relation(fields: [workshopId, assignedTechnicianId], references: [workshopId, userId])
  title                String
  description          String?
  status               RepairTaskStatus @default(PENDING)
  startedAt            DateTime?        @map("started_at")
  completedAt          DateTime?        @map("completed_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([workshopId, serviceOrderId], map: "repair_tasks_workshop_id_service_order_id_idx")
  @@index([workshopId, assignedTechnicianId], map: "repair_tasks_workshop_id_assigned_technician_id_idx")
  @@map("repair_tasks")
}

model Evidence {
  id             String        @id @default(uuid()) @db.Uuid
  workshopId     String        @map("workshop_id") @db.Uuid
  workshop       Workshop      @relation(fields: [workshopId], references: [id])
  serviceOrderId String        @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder  @relation(fields: [workshopId, serviceOrderId], references: [workshopId, id], onDelete: Cascade)
  uploadedById   String        @map("uploaded_by_id") @db.Uuid
  uploadedBy     Membership    @relation(fields: [workshopId, uploadedById], references: [workshopId, userId])
  stage          EvidenceStage
  fileUrl        String        @map("file_url")
  storagePath    String?       @map("storage_path")
  fileType       String?       @map("file_type")
  description    String?
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([workshopId, serviceOrderId], map: "evidences_workshop_id_service_order_id_idx")
  @@index([workshopId, uploadedById], map: "evidences_workshop_id_uploaded_by_id_idx")
  @@map("evidences")
}

model Comment {
  id             String       @id @default(uuid()) @db.Uuid
  workshopId     String       @map("workshop_id") @db.Uuid
  workshop       Workshop     @relation(fields: [workshopId], references: [id])
  serviceOrderId String       @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder @relation(fields: [workshopId, serviceOrderId], references: [workshopId, id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           Membership   @relation(fields: [workshopId, userId], references: [workshopId, userId])
  content        String
  isInternal     Boolean      @default(true) @map("is_internal")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([workshopId, serviceOrderId], map: "comments_workshop_id_service_order_id_idx")
  @@index([workshopId, userId], map: "comments_workshop_id_user_id_idx")
  @@map("comments")
}
